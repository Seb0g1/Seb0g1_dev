[Unit]
Description=Seb0g1.dev API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sebog1.ru/current
EnvironmentFile=/var/www/sebog1.ru/shared/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

# Безопасность процесса
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
